{
  "name": "@taskflow/worker-app",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow worker process for job execution",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@taskflow/config": "workspace:*",
    "@taskflow/database": "workspace:*",
    "@taskflow/logger": "workspace:*",
    "@taskflow/queue": "workspace:*",
    "@taskflow/types": "workspace:*",
    "@taskflow/worker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
