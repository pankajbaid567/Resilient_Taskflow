# Production Environment Variables
# Copy this file to .env.production and update with your values

# Application
NODE_ENV=production
VERSION=latest

# PostgreSQL Configuration
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# API Configuration
API_PORT=3000
API_REPLICAS=2
API_KEY=CHANGE_THIS_API_KEY
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_32_CHARS

# Worker Configuration
WORKER_REPLICAS=3
WORKER_CONCURRENCY=10
WORKER_QUEUES=default,high-priority,low-priority

# Dashboard Configuration
DASHBOARD_PORT=3001
VITE_API_URL=http://localhost:3000/api/v1

# Monitoring
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3002
GRAFANA_PLUGINS=

# Logging
LOG_LEVEL=info

# GitHub (for Docker image pulling)
GITHUB_REPOSITORY_OWNER=your-github-username

# AWS (if deploying to AWS)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Slack (for notifications)
# SLACK_WEBHOOK_URL=
