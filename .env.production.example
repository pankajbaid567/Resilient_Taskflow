# Production-style stack (docker-compose.prod.yml).
# cp .env.production.example .env.prod.local   (git-ignored), then replace every
# CHANGE_THIS value. Generate secrets with: openssl rand -hex 32

# Application
NODE_ENV=production
VERSION=latest

# PostgreSQL Configuration
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=taskflow


# API Configuration
API_REPLICAS=1
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_32_CHARS
# HMAC salt for API key fingerprints (16+ chars). Changing it invalidates every issued key.
API_KEY_HASH_SALT=CHANGE_THIS_SALT_MIN_16_CHARS

# Worker Configuration
WORKER_REPLICAS=2
WORKER_CONCURRENCY=10
WORKER_QUEUES=default,email,critical,low

# Dashboard Configuration
DASHBOARD_PORT=8080
# Leave empty: the dashboard calls /api/v1 on its own origin (nginx proxies it).
VITE_API_URL=

# Monitoring
PROMETHEUS_PORT=9092
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3003

# Logging
LOG_LEVEL=info

# AWS (if deploying to AWS)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Slack (for notifications)
# SLACK_WEBHOOK_URL=

# Retention (runs inside worker processes; one runner at a time via a Redis lock)
RETENTION_ENABLED=true
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=500
RETENTION_JOBS_DAYS=30
RETENTION_EVENTS_DAYS=14
RETENTION_ATTEMPTS_DAYS=14
RETENTION_DEAD_LETTERS_DAYS=30
RETENTION_DELIVERIES_DAYS=7
RETENTION_WORKERS_DAYS=7
RETENTION_IDEMPOTENCY_KEYS_HOURS=24
RETENTION_AUDIT_LOGS_DAYS=90
RETENTION_REDIS_STREAM_MAX_LEN=100000

# Dispatch (priority window): entries kept in flight per queue in Redis. The
# rest of the backlog stays in PostgreSQL, ordered by priority. 0 disables.
DISPATCH_MAX_IN_FLIGHT_PER_QUEUE=200

# Rate limits (requests per user per minute)
RATE_LIMIT_JOB_SUBMISSION_PER_MIN=50
RATE_LIMIT_MUTATION_PER_MIN=50
RATE_LIMIT_READ_PER_MIN=200
RATE_LIMIT_METRICS_PER_MIN=1000

# Worker /metrics endpoint (Prometheus). UNAUTHENTICATED: keep it on loopback or
# a private network. 0 disables it. If the port is taken (several workers on
# one host) the worker logs a warning and runs without it.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1
