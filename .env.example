# Application
NODE_ENV=development
LOG_LEVEL=info

# API Server
API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated proxy IPs/CIDRs. Empty means X-Forwarded-For is not trusted.
API_TRUSTED_PROXIES=
API_SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL
DATABASE_URL=postgresql://taskflow:taskflow_password@localhost:5432/taskflow
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=1000

# Kafka/Redpanda
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=taskflow
KAFKA_GROUP_ID=taskflow-workers

# Worker
WORKER_CONCURRENCY=10
WORKER_QUEUES=default,email,critical
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_LEASE_DURATION_MS=30000

# Job Configuration
JOB_DEFAULT_TIMEOUT_MS=30000
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=1000
JOB_RETRY_MAX_DELAY_MS=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
API_KEY_HASH_SALT=your-api-key-salt-change-this-in-production

# Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
