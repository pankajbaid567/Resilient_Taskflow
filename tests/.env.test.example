# Test Environment Configuration
# Copy to .env.test and customize as needed

# Database
TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5433/taskflow_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=testuser
TEST_DB_PASSWORD=testpass
TEST_DB_NAME=taskflow_test

# Redis
TEST_REDIS_URL=redis://localhost:6380
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380

# Kafka
TEST_KAFKA_BROKERS=localhost:9093

# Test Configuration
TEST_TIMEOUT=30000
TEST_LOG_LEVEL=silent
DEBUG=false

# Container Management
AUTO_START_CONTAINERS=true
CLEANUP_AFTER_TESTS=true
